# =============================================
# RiceCare AI - Environment Variables
# CC26-PSU169 | Coding Camp 2026 DBS Foundation
# =============================================
# Copy file ini menjadi .env dan isi nilainya

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ricecare_db
# Contoh MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/ricecare_db

# JWT
JWT_SECRET=ricecare_super_secret_key_ganti_ini_di_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=ricecare_refresh_secret_key_ganti_ini_di_production
JWT_REFRESH_EXPIRES_IN=30d

# Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# AI Model (untuk integrasi model TFLite)
MODEL_API_URL=http://localhost:8000/predict
MODEL_CONFIDENCE_THRESHOLD=0.6

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000
