{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "env": {
    "VITE_API_URL": "https://rice-care-ai.onrender.com/api/v1"
  },
  "rewrites": [
    {
      "source": "/((?!api|uploads|_next|_static|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
